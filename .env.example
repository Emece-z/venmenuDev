# ─────────────────────────────────────────────────────────────
# Supabase — copiá este archivo a .env.local y completá los valores.
# Dónde: dashboard → Project Settings → API Keys / Data API.
# ─────────────────────────────────────────────────────────────

# URL del proyecto (Settings → Data API → "Project URL").
# Es pública (va al navegador) -> prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública del cliente. En el sistema nuevo es la "Publishable key"
# (sb_publishable_...); en el legacy es la "anon" key (eyJ...). Cualquiera sirve.
# Es pública por diseño; la seguridad la da RLS en la base de datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Clave SECRETA de servidor. En el sistema nuevo es una "Secret key"
# (sb_secret_...); en el legacy es la "service_role" key (eyJ...).
# Nunca se expone al navegador. Bypassa RLS: solo para tareas de plataforma
# (ej. suspender locales por falta de pago cuando integremos cobros).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# URL base del sitio, para construir links absolutos (QR, emails, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
